# Copy this file to .env for local development. Never commit a real .env.
# run.sh loads .env and fails fast when a required value is
# missing; the app itself also refuses to boot without them.

# Required at startup — the app refuses to start without them (R2-04).
# There are no defaults in code.
DB_PASSWORD=change-me-generate-your-own
VERIFICATION_CODE_SECRET=change-me-generate-a-long-random-value
APP_DB_PASSWORD=change-me-generate-your-own

# PII_ENCRYPTION_KEY: REQUIRED at startup, like the three above
# (run.sh refuses to start without it). AES-256-GCM master key for member personal
# data at rest. Generate once (openssl rand -base64 32), BACK IT UP
# in a password manager, and never rotate it casually: without
# it, stored personal data is permanently unreadable.
# PII_ENCRYPTION_KEY=

# Admin bootstrap (set both or neither): the FIRST admin account
# is created from this pair at startup, only while no admin
# exists. The display name defaults to 管理者 when unset.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_DISPLAY_NAME=

# Mail. Local development uses the Mailpit container (no auth, no TLS),
# which is what these defaults describe. Production points them at
# Amazon SES: MAIL_HOST=email-smtp.<region>.amazonaws.com, MAIL_PORT=587,
# MAIL_FROM=a verified sender, and the SES SMTP credentials below.
# When MAIL_USER is set the app sends with TLS required, and startup
# refuses a MAIL_USER without its MAIL_PASSWORD (or the reverse).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@agentic-store.local
# MAIL_USER=
# MAIL_PASSWORD=

# LLM_API_KEY: cloud LLM key for the shopping agent, read only
# when the configured llm_base_url points at a cloud endpoint;
# the local Ollama default needs none.
# LLM_API_KEY=
# TRUST_PROXY_HEADERS: set to 1 ONLY behind a trusted reverse
# proxy (the AWS ALB deployment) so X-Forwarded-For is honoured
# for client-IP resolution (admin guard, throttles); never set
# it on a direct exposure.
# TRUST_PROXY_HEADERS=1

# Deployment only (Session 7): where the copied binary finds its
# config file and static assets, when they do not sit in the build
# workspace layout (R2-15). Unset locally.
# CONFIG_PATH=/etc/agentic-commerce/config.toml
# STATIC_DIR=/opt/agentic-commerce/resources/static

# KOMOJU payments (Payments Spec). All three values are required
# together with `komoju_enabled = true` in config.toml; with any
# piece missing the app logs one error at startup and checkout
# serves cash on delivery only — the store never goes down over
# payment configuration. Test-mode keys only, for the portfolio.
# KOMOJU_SECRET_KEY=
# KOMOJU_WEBHOOK_SECRET=
# PUBLIC_BASE_URL=https://example.jp

# Google Search Console verification token: the `content` value of
# the google-site-verification meta tag Google shows when you add
# the store as a URL-prefix property. When set, the storefront
# layout renders the tag in every page's <head> so Search Console
# can verify ownership; leave unset everywhere else.
# GOOGLE_SITE_VERIFICATION=
# KOMOJU_API_BASE_URL=https://komoju.com

# Stripe payments (Payment Gateways Spec). The second hosted
# rail: selected with `hosted_gateway = "stripe"` together with
# `stripe_enabled = true` in config.toml; all three values are
# required, with the same fail-closed behaviour as KOMOJU.
# Test-mode keys only, for the portfolio.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE_URL=https://api.stripe.com

# SNS login (SNS Login Spec). Each provider also needs
# sns_login_enabled = true in config.toml; a provider stays
# hidden until both of its values are set.
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# Endpoint base overrides for tests (production endpoints
# apply when unset):
# SNS_LINE_BASE_URL=
# SNS_GOOGLE_BASE_URL=
# SNS_YAHOO_BASE_URL=
